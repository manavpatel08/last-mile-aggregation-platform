# ==============================================================================
# Last-Mile Aggregation Platform - Backend Environment Configuration (.env.example)
# Copy this file to .env and configure local connection credentials.
# ==============================================================================

# Application & Runtime Environment
NODE_ENV=development
PORT=3000

# PostgreSQL 18 + PostGIS 3.7 Database Connection
# Uses dedicated local application role lastmile_app on database lastmile_db
DATABASE_URL=postgresql://lastmile_app@127.0.0.1:5432/lastmile_db?schema=public

# Redis 8 Configuration (Ephemeral GPS Telemetry & BullMQ Queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Local OSRM Routing Engine (Gandhinagar OSM Road Network)
OSRM_BACKEND_URL=http://127.0.0.1:5000

# Authentication & JWT Configuration
JWT_ACCESS_SECRET=dev-access-secret-minimum-32-chars-long-placeholder!
JWT_ACCESS_EXPIRY=900
REFRESH_TOKEN_MAX_DAYS=30

# Google OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID_IOS=placeholder-ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=placeholder-android-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=placeholder-web-client-id.apps.googleusercontent.com

# Matching & Scheduling Parameters
MATCHING_BATCH_INTERVAL_MS=60000
MAX_SHARED_WAIT_DEADLINE_MS=120000
DRIVER_OFFER_TIMEOUT_SEC=20
MAX_DETOUR_PERCENT=25.0

# Pilot Tariff Parameters (Stored in integer paise: 100 paise = ₹1.00)
BASE_FARE_PAISE=2000
PER_KM_RATE_PAISE=1000

# Simulation & Demo Mode Flag
DEMO_MODE=true
