# LastMile Mobile Environment Configuration Example
# Copy to .env and pass with: flutter run --dart-define-from-file=.env
# Never commit local .env files containing secrets or machine-specific credentials.

# Backend REST API base URL (must include /api/v1 prefix)
# - iOS Simulator:    http://localhost:3000/api/v1
# - Android Emulator: http://10.0.2.2:3000/api/v1
# - Physical Device:  http://<MAC_LAN_IP>:3000/api/v1
API_BASE_URL=http://localhost:3000/api/v1

# Realtime Socket.IO base URL (used in future realtime integration stage)
# - iOS Simulator:    ws://localhost:3000/realtime
# - Android Emulator: ws://10.0.2.2:3000/realtime
# - Physical Device:  ws://<MAC_LAN_IP>:3000/realtime
SOCKET_BASE_URL=ws://localhost:3000/realtime

# Application environment (development | staging | production)
APP_ENV=development

# Optional initial UI mode override (PASSENGER | DRIVER; leave empty for Role Selection)
APP_MODE=

# Google OAuth Client IDs (placeholders until provisioned in Google Cloud Console)
# - iOS: Required for iOS OAuth client identification
GOOGLE_CLIENT_ID_IOS=396217402740-mfid5nupvjtg4c8k6dsuugq55bf70s9k.apps.googleusercontent.com
# - Server/Web Client ID: Required for Android and backend audience verification
GOOGLE_CLIENT_ID_WEB=396217402740-lm3m1hpmilkk1agrfq6k1pjtual225li.apps.googleusercontent.com

# Optional Next.js Admin Operations Portal URL (for administrator accounts)
# Default development: http://localhost:3001
ADMIN_PORTAL_URL=
